<button class="theme-switch" type="button" role="switch" aria-label="Dark mode" aria-checked="false">
  <span class="track">
    <span class="knob"></span>
    <svg class="sun" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
      <circle cx="12" cy="12" r="4" fill="currentColor"></circle>
      <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
    </svg>
    <svg class="moon" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
    </svg>
  </span>
</button>

<script>
  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>('.theme-switch');
  const systemDark = matchMedia('(prefers-color-scheme: dark)');

  const apply = (theme: 'light' | 'dark') => {
    root.dataset.theme = theme;
    button?.setAttribute('aria-checked', String(theme === 'dark'));
  };

  const savedTheme = () => {
    try {
      return localStorage.getItem('theme');
    } catch {
      return null;
    }
  };

  apply(root.dataset.theme === 'dark' ? 'dark' : 'light');

  button?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    apply(next);
    try {
      localStorage.setItem('theme', next);
    } catch {
      // Private browsing can block storage. The switch still works for this page.
    }
  });

  // Keep following the system setting until the visitor makes their own choice.
  systemDark.addEventListener('change', (event) => {
    if (!savedTheme()) apply(event.matches ? 'dark' : 'light');
  });
</script>

<style>
  .theme-switch {
    display: flex;
    align-items: center;
    width: 52px;
    height: 44px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  /* Without JavaScript there is no data-theme, so the page follows the system
     setting and the switch, which could not work, stays hidden. */
  :global(html:not([data-theme])) .theme-switch {
    display: none;
  }

  .track {
    position: relative;
    display: block;
    width: 52px;
    height: 28px;
    border-radius: 14px;
    background: var(--track);
    color: var(--track-ink);
  }

  .knob {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--knob);
    transition: left 0.15s ease;
  }

  .sun,
  .moon {
    position: absolute;
    top: 7px;
  }

  .sun {
    right: 7px;
  }

  .moon {
    left: 7px;
    display: none;
  }

  :global(html[data-theme='dark']) .knob {
    left: 27px;
  }

  :global(html[data-theme='dark']) .sun {
    display: none;
  }

  :global(html[data-theme='dark']) .moon {
    display: block;
  }

  @media (prefers-reduced-motion: reduce) {
    .knob {
      transition: none;
    }
  }
</style>
